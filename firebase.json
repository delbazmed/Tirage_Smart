{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "node_modules/**", ".github/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.wasm.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] }
    ]
  }
}
